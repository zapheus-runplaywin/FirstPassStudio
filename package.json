{
  "name": "firstpass-studio",
  "productName": "FirstPass Studio",
  "version": "0.1.0",
  "description": "Live PlayHQ graphics for livestreams, by PIVT",
  "author": "PIVT",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-report.mjs --test-reporter-destination=stdout test/*.test.js",
    "iconpack": "node plugins/characters-iconpack/build.js",
    "fonts": "node vendor/fonts/fetch.js",
    "app": "electron .",
    "dist": "electron-builder --mac --publish never",
    "release": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.runplaywin.firstpassstudio",
    "productName": "FirstPass Studio",
    "copyright": "\u00a9 PIVT",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "server.js",
      "competitions.js",
      "playhq.js",
      "athletes.js",
      "board.js",
      "games.js",
      "finals.js",
      "scene.js",
      "zip.js",
      "outputs.js",
      "datadir.js",
      "savefile.js",
      "datalocation.js",
      "migrations.js",
      "linkhost.js",
      "access.js",
      "sequences.js",
      "music.js",
      "fonts.js",
      "sponsors.js",
      "exposure.js",
      "viewers.js",
      "config.json",
      "public/**/*",
      "imports/**/*",
      "desktop/**/*",
      "vendor/ffmpeg/ffmpeg",
      "vendor/ffmpeg/LICENSE.md",
      "native/decklink/build/Release/decklink.node",
      "native/ndi/build/Release/ndi.node",
      "plugins/studio-deck/dist/com.runplaywin.firstpass-studio.streamDeckPlugin"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "FirstPass-Studio-${version}-${arch}-mac.${ext}",
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "notarize": true,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "FirstPass Studio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zapheus-runplaywin",
        "repo": "FirstPassStudio-releases",
        "releaseType": "release"
      }
    ]
  }
}
