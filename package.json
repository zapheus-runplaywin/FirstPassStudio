{
  "name": "firstpass-studio",
  "productName": "FirstPass Studio",
  "version": "0.1.0",
  "description": "Live PlayHQ graphics for OBS, by PIVT",
  "author": "PIVT",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --mac --publish never",
    "release": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.runplaywin.firstpassstudio",
    "productName": "FirstPass Studio",
    "copyright": "© PIVT",
    "asar": false,
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "package.json",
      "server.js",
      "competitions.js",
      "finals.js",
      "datadir.js",
      "migrations.js",
      "linkhost.js",
      "config.json",
      "public/**/*",
      "imports/**/*",
      "desktop/**/*"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "artifactName": "FirstPass-Studio-${version}-${arch}-mac.${ext}",
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "notarize": true,
      "extendInfo": { "LSUIElement": true }
    },
    "dmg": { "title": "FirstPass Studio" },
    "publish": [
      { "provider": "github", "owner": "zapheus-runplaywin", "repo": "FirstPassStudio-releases", "releaseType": "release" }
    ]
  }
}
