{
  "name": "firstpass-studio",
  "productName": "FirstPass Studio",
  "version": "0.1.0",
  "description": "Live PlayHQ graphics for livestreams, by PIVT",
  "author": "PIVT",
  "license": "MIT",
  "private": true,
  "main": "out/desktop/main.js",
  "workspaces": [
    "packages/playhq"
  ],
  "scripts": {
    "start": "npm run build && node out/server.js",
    "test": "node --test test/*.test.js",
    "test:ci": "node --test --test-timeout=480000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/support/github-report.mjs --test-reporter-destination=stdout test/*.test.js",
    "iconpack": "node plugins/characters-iconpack/build.js",
    "fonts": "node vendor/fonts/fetch.js",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac --publish never",
    "release": "npm run build && electron-builder --mac --publish always",
    "build": "npm run build --workspaces && tsc -p . && tsc -p public && tsc -p public/output",
    "watch": "tsc -p . --watch & tsc -p public --watch & tsc -p public/output --watch",
    "examples": "npm run build && node out/examples.js",
    "pretest": "npm run build",
    "pretest:ci": "npm run build"
  },
  "dependencies": {
    "@firstpass/playhq": "0.2.0",
    "atem-connection": "3.10.3",
    "electron-updater": "6.8.11",
    "qrcode-generator": "2.0.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.runplaywin.firstpassstudio",
    "productName": "FirstPass Studio",
    "copyright": "\u00a9 PIVT",
    "asar": true,
    "asarUnpack": [
      "vendor/ffmpeg/**",
      "native/**/*.node",
      "plugins/studio-deck/dist/**",
      "node_modules/@julusian/freetype2/prebuilds/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "out/**/*.js",
      "!out/**/*.map",
      "config.json",
      "public/**/*",
      "!public/**/*.ts",
      "!public/**/tsconfig.json",
      "docs/user-guide/index.html",
      "docs/user-guide/img/*.{webp,svg}",
      "imports/**/*",
      "desktop/*.{html,png,json}",
      "vendor/ffmpeg/ffmpeg",
      "vendor/ffmpeg/LICENSE.md",
      "native/decklink/build/Release/decklink.node",
      "native/ndi/build/Release/ndi.node",
      "plugins/studio-deck/dist/com.runplaywin.firstpass-studio.streamDeckPlugin"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "FirstPass-Studio-${version}-${arch}-mac.${ext}",
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "notarize": true,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "FirstPass Studio mixes the mics you add on the Output page into the stream's sound."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "FirstPass Studio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zapheus-runplaywin",
        "repo": "FirstPassStudio-releases",
        "releaseType": "release"
      }
    ]
  }
}
