{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "FirstPass Studio",
	"Version": "1.0.0.0",
	"Author": "PIVT",
	"Description": "Keys for FirstPass Studio's scene: show and hide its sources, go to saved scenes, play sequences, and see which are on. Also presses the ATEM switcher Studio controls, with its tally, and runs a 4K replay or practice game from Studio's Recordings tab.",
	"Icon": "imgs/plugin/icon",
	"Category": "FirstPass Studio",
	"CategoryIcon": "imgs/plugin/category",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"UUID": "com.runplaywin.firstpass-studio",
	"Actions": [
		{
			"Name": "Source",
			"UUID": "com.runplaywin.firstpass-studio.source",
			"Icon": "imgs/actions/source/icon",
			"Tooltip": "Shows or hides a source in Studio's scene. Lights up while it's on.",
			"PropertyInspectorPath": "ui/source.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/source/off",
					"Name": "Off",
					"TitleAlignment": "middle",
					"TitleColor": "#ffffff",
					"FontSize": 12
				},
				{
					"Image": "imgs/actions/source/on",
					"Name": "On",
					"TitleAlignment": "middle",
					"TitleColor": "#000000",
					"FontSize": 12
				}
			]
		},
		{
			"Name": "Scene",
			"UUID": "com.runplaywin.firstpass-studio.scene",
			"Icon": "imgs/actions/scene/icon",
			"Tooltip": "Goes to a saved scene in Studio, or the next or previous one, or back to the current one as saved. Lights up while its scene is on.",
			"PropertyInspectorPath": "ui/scene.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/scene/off",
					"Name": "Off",
					"TitleAlignment": "middle",
					"TitleColor": "#ffffff",
					"FontSize": 12
				},
				{
					"Image": "imgs/actions/scene/on",
					"Name": "On",
					"TitleAlignment": "middle",
					"TitleColor": "#000000",
					"FontSize": 12
				}
			]
		},
		{
			"Name": "Sequence",
			"UUID": "com.runplaywin.firstpass-studio.sequence",
			"Icon": "imgs/actions/sequence/icon",
			"Tooltip": "Plays or stops a sequence in Studio, or moves on, pauses or stops whatever is playing. Lights up and counts down while it plays.",
			"PropertyInspectorPath": "ui/sequence.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/sequence/off",
					"Name": "Off",
					"TitleAlignment": "middle",
					"TitleColor": "#ffffff",
					"FontSize": 12
				},
				{
					"Image": "imgs/actions/sequence/on",
					"Name": "Playing",
					"TitleAlignment": "middle",
					"TitleColor": "#000000",
					"FontSize": 12
				}
			]
		},
		{
			"Name": "Switcher",
			"UUID": "com.runplaywin.firstpass-studio.switcher",
			"Icon": "imgs/actions/switcher/icon",
			"Tooltip": "Presses the ATEM switcher picked on Studio's Output page: a camera to preview or program, a stinger, Cut, Auto, a key, Fade to black or a macro. Lights red on program and green on preview.",
			"PropertyInspectorPath": "ui/switcher.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/switcher/off",
					"Name": "Off",
					"TitleAlignment": "middle",
					"TitleColor": "#ffffff",
					"FontSize": 12
				},
				{
					"Image": "imgs/actions/switcher/on",
					"Name": "On air",
					"TitleAlignment": "middle",
					"TitleColor": "#000000",
					"FontSize": 12
				}
			]
		},
		{
			"Name": "Replay",
			"UUID": "com.runplaywin.firstpass-studio.playback",
			"Icon": "imgs/actions/playback/icon",
			"Tooltip": "Plays, pauses, nudges, jumps or stops the 4K replay or practice game started on Studio's Recordings tab, whichever is running. Lights up while one runs.",
			"PropertyInspectorPath": "ui/playback.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/playback/off",
					"Name": "Off",
					"TitleAlignment": "middle",
					"TitleColor": "#ffffff",
					"FontSize": 12
				},
				{
					"Image": "imgs/actions/playback/on",
					"Name": "Running",
					"TitleAlignment": "middle",
					"TitleColor": "#000000",
					"FontSize": 12
				}
			]
		}
	]
}
