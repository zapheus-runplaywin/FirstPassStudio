{
	"name": "firstpass-studio-streamdeck",
	"version": "1.0.0",
	"private": true,
	"description": "Stream Deck plugin for FirstPass Studio: keys that show and hide the Studio scene's sources and light up while they're on.",
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.runplaywin.firstpass-studio\"",
		"link": "streamdeck link com.runplaywin.firstpass-studio.sdPlugin",
		"restart": "streamdeck restart com.runplaywin.firstpass-studio",
		"validate": "streamdeck validate com.runplaywin.firstpass-studio.sdPlugin",
		"pack": "npm run build && streamdeck pack com.runplaywin.firstpass-studio.sdPlugin --output dist --force",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test test/*.test.ts",
		"test:ci": "tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../test/support/github-report.mjs --test-reporter-destination=stdout test/*.test.ts"
	},
	"devDependencies": {
		"@elgato/cli": "1.10.3",
		"@rollup/plugin-commonjs": "29.0.3",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-terser": "1.0.2",
		"@tsconfig/node24": "24.0.5",
		"@types/node": "26.6.6",
		"esbuild": "0.28.2",
		"rollup": "4.66.0",
		"rollup-plugin-esbuild": "6.2.1",
		"tsx": "4.23.15",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@elgato/streamdeck": "3.0.3"
	}
}
